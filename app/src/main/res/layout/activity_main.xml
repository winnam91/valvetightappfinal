<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".MainActivity">
        <!-- Overall padding is removed from here and applied selectively or via margins -->

        <!-- Logo ImageView - Now at the very top of the content area -->
        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:src="@drawable/valvetight_logo"
            android:contentDescription="@string/app_logo_description"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"/>
        <!-- Margin from the top edge of the screen -->
        <!-- App Title TextView -->
        <TextView
            android:id="@+id/textViewAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_title"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imageViewLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <!-- Component Type Label -->
        <TextView
            android:id="@+id/textViewComponentTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:text="@string/component_type_label"
            app:layout_constraintTop_toBottomOf="@id/textViewAppTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/spinnerComponentType" />

        <!-- Component Type Spinner -->
        <Spinner
            android:id="@+id/spinnerComponentType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="@id/textViewComponentTypeLabel"
            app:layout_constraintStart_toEndOf="@id/textViewComponentTypeLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:entries="@array/component_types_array" />

        <!-- Section for "Unknown Volume" - Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutComponentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:minHeight="56dp"
            android:hint="@string/component_name_hint"
            app:layout_constraintTop_toBottomOf="@id/spinnerComponentType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextComponentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Group for Dimensional Inputs (Used by "Unknown Volume") -->
        <LinearLayout
            android:id="@+id/layoutDimensionalInputs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutComponentName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutDiameter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:minHeight="56dp"
                android:hint="@string/enter_inner_diameter_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextDiameter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:hint="@string/enter_length_hint">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textViewUnitsDimensionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/units_for_dimensions_label"/>

            <Spinner
                android:id="@+id/spinnerUnitsDimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:entries="@array/dimension_units_array" />
        </LinearLayout>

        <!-- Quantity Input - Common for all types -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutQuantity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="@string/quantity_hint"
            android:minHeight="56dp"
            app:layout_constraintTop_toBottomOf="@+id/layoutDimensionalInputs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="visible">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="@string/default_quantity" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Add Component Button -->
        <Button
            android:id="@+id/buttonAddComponent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/add_component_button_text"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutQuantity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Added Components List Label -->
        <TextView
            android:id="@+id/textViewAddedComponentsListLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/added_components_list_label"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/buttonAddComponent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- ScrollView for Added Components -->
        <ScrollView
            android:id="@+id/scrollViewComponents"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/textViewAddedComponentsListLabel"
            app:layout_constraintBottom_toTopOf="@id/textViewTotalVolume"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/light_gray"
            android:nestedScrollingEnabled="true"
        android:fillViewport="true">
            <TextView
                android:id="@+id/textViewAddedComponentsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                tools:text="Hose x 2 (5.71L each): 11.42L" />
        </ScrollView>

        <!-- Total Volume Display -->
        <TextView
            android:id="@+id/textViewTotalVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:text="@string/initial_total_volume"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/buttonResetAll"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Reset All Button -->
        <Button
            android:id="@+id/buttonResetAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/reset_all_button_text"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>