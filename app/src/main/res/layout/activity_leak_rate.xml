<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".LeakRateActivity">

        <TextView
            android:id="@+id/textViewLeakRateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leak_rate_activity_title"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutSystemVolume"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/system_volume_hint_editable"
            app:suffixText="L"
            app:layout_constraintTop_toBottomOf="@id/textViewLeakRateTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextSystemVolumeLiters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutPressureChangeRate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/pressure_change_rate_hint"
        app:suffixText="bar/min"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutSystemVolume"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextPressureChangeRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutBleedDiameter"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/bleed_diameter_hint"
    app:suffixText="mm"
    app:layout_constraintTop_toBottomOf="@id/textInputLayoutPressureChangeRate"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editTextBleedDiameter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"/>
</com.google.android.material.textfield.TextInputLayout>

<Button
android:id="@+id/buttonCalculateAnalysis"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:minHeight="48dp"
android:layout_marginTop="24dp"
android:text="@string/calculate_button"
app:layout_constraintTop_toBottomOf="@id/textInputLayoutBleedDiameter"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"/>

<TextView
android:id="@+id/textViewCalculatedLeakRateLabel"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:text="@string/leak_rate_label"
    android:textStyle="bold"
    app:layout_constraintTop_toBottomOf="@id/buttonCalculateAnalysis"
    app:layout_constraintStart_toStartOf="parent"/>
<TextView
android:id="@+id/textViewLeakRateResult"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="8dp"
android:text="@string/leak_rate_result_placeholder"
android:textAppearance="?attr/textAppearanceBody1"
app:layout_constraintTop_toTopOf="@id/textViewCalculatedLeakRateLabel"
app:layout_constraintBottom_toBottomOf="@id/textViewCalculatedLeakRateLabel"
app:layout_constraintStart_toEndOf="@id/textViewCalculatedLeakRateLabel"
app:layout_constraintEnd_toEndOf="parent"/>

<TextView
android:id="@+id/textViewVelocityLabel"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:text="@string/velocity_label"
android:textStyle="bold"
app:layout_constraintTop_toBottomOf="@id/textViewCalculatedLeakRateLabel"
app:layout_constraintStart_toStartOf="parent"/>
<TextView
android:id="@+id/textViewVelocityResult"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="8dp"
android:text="@string/velocity_result_placeholder"
android:textAppearance="?attr/textAppearanceBody1"
app:layout_constraintTop_toTopOf="@id/textViewVelocityLabel"
app:layout_constraintBottom_toBottomOf="@id/textViewVelocityLabel"
app:layout_constraintStart_toEndOf="@id/textViewVelocityLabel"
app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>