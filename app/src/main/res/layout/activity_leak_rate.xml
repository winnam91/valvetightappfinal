<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".LeakRateActivity">

        <TextView
            android:id="@+id/textViewLeakRateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leak_rate_activity_title"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewSystemVolumeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/system_volume_label"
            app:layout_constraintTop_toBottomOf="@id/textViewLeakRateTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/textViewSystemVolumeValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            tools:text="123.456 L (0.12345 m³)"
            android:textAppearance="?attr/textAppearanceBody1"
            app:layout_constraintTop_toTopOf="@id/textViewSystemVolumeLabel"
            app:layout_constraintBottom_toBottomOf="@id/textViewSystemVolumeLabel"
            app:layout_constraintStart_toEndOf="@id/textViewSystemVolumeLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Initial Pressure P1 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutInitialPressure"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/initial_pressure_hint"
            app:layout_constraintTop_toBottomOf="@id/textViewSystemVolumeLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextInitialPressure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Final Pressure P2 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutFinalPressure"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/final_pressure_hint"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutInitialPressure"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextFinalPressure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pressure Units -->
        <TextView
            android:id="@+id/textViewPressureUnitsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pressure_units_label"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutFinalPressure"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/spinnerPressureUnits"/>
        <Spinner
            android:id="@+id/spinnerPressureUnits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/textViewPressureUnitsLabel"
            app:layout_constraintStart_toEndOf="@id/textViewPressureUnitsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:entries="@array/pressure_units_array" />

        <!-- Time Duration -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutTimeDuration"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/time_duration_hint"
            app:layout_constraintTop_toBottomOf="@id/spinnerPressureUnits"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTimeDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Time Units -->
        <TextView
            android:id="@+id/textViewTimeUnitsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/time_units_label"
            app:layout_constraintTop_toBottomOf="@id/textInputLayoutTimeDuration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/spinnerTimeUnits"/>
        <Spinner
            android:id="@+id/spinnerTimeUnits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/textViewTimeUnitsLabel"
            app:layout_constraintStart_toEndOf="@id/textViewTimeUnitsLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:entries="@array/time_units_array" />

        <!-- Calculate Button -->
        <Button
            android:id="@+id/buttonCalculateLeakRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/calculate_leak_rate_button"
            app:layout_constraintTop_toBottomOf="@id/spinnerTimeUnits"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Result Display -->
        <TextView
            android:id="@+id/textViewCalculatedLeakRateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calculated_leak_rate_label"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/buttonCalculateLeakRate"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:id="@+id/textViewLeakRateResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/leak_rate_result_placeholder"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintTop_toTopOf="@id/textViewCalculatedLeakRateLabel"
            app:layout_constraintBottom_toBottomOf="@id/textViewCalculatedLeakRateLabel"
            app:layout_constraintStart_toEndOf="@id/textViewCalculatedLeakRateLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>