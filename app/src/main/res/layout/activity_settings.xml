<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="?attr/colorSurface"
    tools:context=".SettingsActivity">

    <TextView
        android:id="@+id/textViewSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_activity_title"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Pressure Unit Preference Row -->
    <TextView
        android:id="@+id/labelPrefPressureUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pref_pressure_unit_label"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        app:layout_constraintTop_toBottomOf="@id/textViewSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cardPrefPressureUnit"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="@id/cardPrefPressureUnit"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrefPressureUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/labelPrefPressureUnit"
        app:layout_constraintBottom_toBottomOf="@id/labelPrefPressureUnit"
        app:layout_constraintStart_toEndOf="@id/labelPrefPressureUnit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2">
        <Spinner
            android:id="@+id/spinnerPrefPressureUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:entries="@array/pressure_units_global_array"/>
    </com.google.android.material.card.MaterialCardView>


    <!-- Dimension Unit Preference Row -->
    <TextView
        android:id="@+id/labelPrefDimensionUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pref_dimension_unit_label"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        app:layout_constraintTop_toBottomOf="@id/cardPrefPressureUnit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cardPrefDimensionUnit"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="@id/cardPrefDimensionUnit"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrefDimensionUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/labelPrefDimensionUnit"
        app:layout_constraintBottom_toBottomOf="@id/labelPrefDimensionUnit"
        app:layout_constraintStart_toEndOf="@id/labelPrefDimensionUnit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2">
        <Spinner
            android:id="@+id/spinnerPrefDimensionUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:entries="@array/dimension_units_array"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Line Size (Bleed Diameter) Unit Preference Row -->
    <TextView
        android:id="@+id/labelPrefLineSizeUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pref_line_size_unit_label"
    android:textAppearance="?attr/textAppearanceSubtitle1"
    app:layout_constraintTop_toBottomOf="@id/cardPrefDimensionUnit"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@+id/cardPrefLineSizeUnit"
    app:layout_constraintHorizontal_weight="1"
    app:layout_constraintBottom_toBottomOf="@id/cardPrefLineSizeUnit"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrefLineSizeUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="2dp"
        app:cardCornerRadius="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/labelPrefLineSizeUnit"
        app:layout_constraintBottom_toBottomOf="@id/labelPrefLineSizeUnit"
        app:layout_constraintStart_toEndOf="@id/labelPrefLineSizeUnit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2">
        <Spinner
            android:id="@+id/spinnerPrefLineSizeUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:entries="@array/bleed_diameter_units_array"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Done Button -->
    <Button
        android:id="@+id/buttonSettingsDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/settings_done_button"
        app:layout_constraintTop_toBottomOf="@id/cardPrefLineSizeUnit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>