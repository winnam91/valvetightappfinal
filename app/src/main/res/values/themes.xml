<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ValveTight" parent="Theme.MaterialComponents.Light.NoActionBar"> <!-- CHANGED HERE -->

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color.
             With NoActionBar, you might want to set this to a specific color or manage it differently
             if you want content to draw under the status bar. For now, this should be okay.
             This colorPrimaryVariant will color the status bar. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- You can also directly use: <item name="android:statusBarColor">@color/purple_700</item> -->

        <!-- Customize your theme here. -->
    </style>
</resources>